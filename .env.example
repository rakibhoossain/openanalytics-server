# ==============================================================================
# OpenAnalytics Production Environment Configuration (Server 91.99.83.171)
# ==============================================================================

# Server Environment & Logging
ENV=production
LOG_LEVEL=info

# Service Ports (Exposed on host; reverse-proxied via Nginx)
INGEST_PORT=8080
QUERY_PORT=8081
METRICS_PORT=9090

# ------------------------------------------------------------------------------
# 1. OLAP Columnar Store: ClickHouse (Official 26.8.8.8)
# ------------------------------------------------------------------------------
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=openpanel
CLICKHOUSE_USERNAME=openpanel
CLICKHOUSE_PASSWORD=openpanel
CLICKHOUSE_DEBUG=false

# ------------------------------------------------------------------------------
# 2. Ephemeral State, Pub/Sub & Counters: Redis 7
# ------------------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# 3. Relational Storage: PostgreSQL 18 (For Meta CAPI & Tenant Config)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_DB=analytics_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/analytics_db?sslmode=disable
POSTGRES_MAX_CONNS=25

# ------------------------------------------------------------------------------
# 4. Kafka Event Streaming Pipeline (Broker on Server 91.99.83.171)
# ------------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_EVENTS_TOPIC=analytics.events.raw
KAFKA_SESSIONS_TOPIC=analytics.sessions.boundary
KAFKA_CONSUMER_GROUP=openanalytics-worker-group
KAFKA_BATCH_SIZE=5000
KAFKA_BATCH_TIMEOUT_MS=1000

# ------------------------------------------------------------------------------
# 5. GeoIP Database Auto-Updater (MaxMind GeoLite2 City & ASN)
# ------------------------------------------------------------------------------
GEOIP_DATA_DIR=/usr/share/GeoIP
GEOIPUPDATE_ACCOUNT_ID=id
GEOIPUPDATE_LICENSE_KEY=key

# ------------------------------------------------------------------------------
# 6. Behavioral Machine Learning & Automated Daily Retraining
# ------------------------------------------------------------------------------
ML_MODEL_PATH=/app/data/models/cart_intent_v1.json
ML_INFERENCE_ENABLED=true
RETRAIN_INTERVAL_HOURS=24

# ------------------------------------------------------------------------------
# 7. Security Pre-shared Key & Multi-Currency Normalization
# ------------------------------------------------------------------------------
ANALYTICS_AUTH_KEY=aicart_analytics_internal_secret_key_8503c2a0
OPENEXCHANGERATES_APP_ID=ap_key
EXCHANGE_RATE_SYNC_HOURS=6

# ------------------------------------------------------------------------------
# Docker Registry Configuration
# ------------------------------------------------------------------------------
DOCKER_REGISTRY=rakibhoossain
TAG=latest
